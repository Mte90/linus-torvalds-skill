# === Secrets ===
.env
.env.*
!.env.example

# === Local profile overrides (legitimate local config, not committable) ===
profiles.toml

# === Re-downloadable data (regenerable via pipeline) ===
# data/lkml.mbox      — 192MB, from NNTP (scripts/fetch_torvalds_mbox.py)
# data/corpus.jsonl   — 59MB,  from mbox (scripts/mbox_to_jsonl.py)
# data/reviews.jsonl  — 40MB,  classified reviews
# data/moves.jsonl    — 23MB,  LLM extraction (~$5-8 to regenerate)
# data/patterns.json  — 116KB, from cluster stage
# data/manifest.json  — 4KB,   provenance metadata
# NOTE: `data/*`, not `data/` — git does not descend into an excluded directory,
# so `data/` would make the curated-file negations below silently ineffective.
data/*

# === Eval assets (commit these: they are the evidence behind report numbers) ===
# Without them nobody can reproduce or verify any figure in comparison.md /
# cross_matrix.md. Kept small: the diff set is fixed, and the result files hold
# one JSON record per (model, skill, diff).
!data/eval_diffs.jsonl
!data/eval_diffs.schema.json
!data/eval_results.jsonl
!data/eval_results_cross.jsonl
# Intermediate/throwaway eval files stay ignored.
data/eval_results*.bak.*
data/eval_results*.tmp
data/eval_results*.reps3-partial
report/baseline/

# === Curated data worth committing (not re-downloadable) ===
# skip_list.json — 6379 message IDs that produce 0 moves; saves API calls on future runs
!data/skip_list.json
!data/benchmark.jsonl
!data/benchmark.schema.json

# === Legacy output dir (no longer used; skill now lives in linus-torvalds-skill/) ===
out/

# === Python ===
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
build/
dist/
.venv/
venv/

# === Test / cache ===
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# === Logs / checkpoints ===
*.log
data/checkpoint.jsonl
data/fetch_progress.json
report/metrics.jsonl
report/.review_state.json

# === Baseline reviews ===
report/baseline/

# === Review chunks (generated prompts and outputs) ===
report/chunks/

# === Editor / IDE ===
.vscode/
.idea/
*.swp
*.swo
*~
.project
.settings/

# === OS ===
.DS_Store
Thumbs.db

