# LLM API configuration — copy to .env and fill in.
# Works with any OpenAI-compatible endpoint (Regolo, OpenAI, Ollama, etc.)

# API key — any of these three env vars works:
REGOLO_API_KEY=sk-your-key-here
# OPENAI_API_KEY=sk-your-key-here
# LLM_API_KEY=sk-your-key-here

# API endpoint — any of these works:
LLM_HOST=https://api.regolo.ai/v1
# OPENAI_BASE_URL=https://api.openai.com/v1

# Model to use for extraction and distillation
LLM_MODEL=gpt-oss-120b

# --- Caching configuration ---
# Path to LLM cache file (default: data/llm_cache.jsonl)
LLM_CACHE_PATH=data/llm_cache.jsonl
# Cache TTL in hours (default: 24)
LLM_CACHE_TTL_HOURS=24
# Set to 0 to disable extraction cache (default: 1)
EXTRACT_CACHE=1

# --- Profile overrides (optional) ---
# Override model profile fields: LLM_PROFILE_<NAME>__<FIELD>
# Example: LLM_PROFILE_GLM52__TIMEOUT=900
# Available fields: reasoning, slow, timeout, max_tokens, parallel_workers,
#                   review_timeout, distill_mode, prompt_budget_chars,
#                   strict_truncation, fallback_models, review_max_tokens
# LLM_PROFILE_GLM52__TIMEOUT=600
# LLM_PROFILE_GPT_OSS_120B__PARALLEL_WORKERS=5
